<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================================================
         Tenant isolation: ensure every clinic-scoped row carries its
         clinic_id directly so Hibernate @Filter can enforce isolation
         without joins. Backfills are derived from parent FKs.
         ============================================================ -->

    <changeSet id="007-visit-clinic-id" author="claude">
        <addColumn tableName="visit">
            <column name="clinic_id" type="BIGINT"/>
        </addColumn>
        <sql>
            UPDATE visit v SET clinic_id = p.clinic_id
            FROM patient p WHERE p.id = v.patient_id AND v.clinic_id IS NULL;
        </sql>
        <addNotNullConstraint tableName="visit" columnName="clinic_id"/>
        <addForeignKeyConstraint baseTableName="visit" baseColumnNames="clinic_id"
                                 referencedTableName="clinic" referencedColumnNames="id"
                                 constraintName="fk_visit_clinic"/>
        <createIndex tableName="visit" indexName="idx_visit_clinic"><column name="clinic_id"/></createIndex>
    </changeSet>

    <changeSet id="007-stock-batch-clinic-id" author="claude">
        <addColumn tableName="stock_batch">
            <column name="clinic_id" type="BIGINT"/>
        </addColumn>
        <sql>
            UPDATE stock_batch b SET clinic_id = m.clinic_id
            FROM medicine m WHERE m.id = b.medicine_id AND b.clinic_id IS NULL;
        </sql>
        <addNotNullConstraint tableName="stock_batch" columnName="clinic_id"/>
        <addForeignKeyConstraint baseTableName="stock_batch" baseColumnNames="clinic_id"
                                 referencedTableName="clinic" referencedColumnNames="id"
                                 constraintName="fk_batch_clinic"/>
        <createIndex tableName="stock_batch" indexName="idx_batch_clinic"><column name="clinic_id"/></createIndex>
    </changeSet>

    <changeSet id="007-stock-movement-clinic-id" author="claude">
        <addColumn tableName="stock_movement">
            <column name="clinic_id" type="BIGINT"/>
        </addColumn>
        <sql>
            UPDATE stock_movement mv SET clinic_id = b.clinic_id
            FROM stock_batch b WHERE b.id = mv.stock_batch_id AND mv.clinic_id IS NULL;
        </sql>
        <addNotNullConstraint tableName="stock_movement" columnName="clinic_id"/>
        <addForeignKeyConstraint baseTableName="stock_movement" baseColumnNames="clinic_id"
                                 referencedTableName="clinic" referencedColumnNames="id"
                                 constraintName="fk_movement_clinic"/>
        <createIndex tableName="stock_movement" indexName="idx_movement_clinic"><column name="clinic_id"/></createIndex>
    </changeSet>

    <changeSet id="007-sale-item-clinic-id" author="claude">
        <addColumn tableName="sale_item">
            <column name="clinic_id" type="BIGINT"/>
        </addColumn>
        <sql>
            UPDATE sale_item si SET clinic_id = s.clinic_id
            FROM sale s WHERE s.id = si.sale_id AND si.clinic_id IS NULL;
        </sql>
        <addNotNullConstraint tableName="sale_item" columnName="clinic_id"/>
        <addForeignKeyConstraint baseTableName="sale_item" baseColumnNames="clinic_id"
                                 referencedTableName="clinic" referencedColumnNames="id"
                                 constraintName="fk_saleitem_clinic"/>
        <createIndex tableName="sale_item" indexName="idx_saleitem_clinic"><column name="clinic_id"/></createIndex>
    </changeSet>

    <changeSet id="007-prescription-item-clinic-id" author="claude">
        <addColumn tableName="prescription_item">
            <column name="clinic_id" type="BIGINT"/>
        </addColumn>
        <sql>
            UPDATE prescription_item pi SET clinic_id = v.clinic_id
            FROM visit v WHERE v.id = pi.visit_id AND pi.clinic_id IS NULL;
        </sql>
        <addNotNullConstraint tableName="prescription_item" columnName="clinic_id"/>
        <addForeignKeyConstraint baseTableName="prescription_item" baseColumnNames="clinic_id"
                                 referencedTableName="clinic" referencedColumnNames="id"
                                 constraintName="fk_rxitem_clinic"/>
        <createIndex tableName="prescription_item" indexName="idx_rxitem_clinic"><column name="clinic_id"/></createIndex>
    </changeSet>

</databaseChangeLog>
