<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Versioned terms / privacy / disclaimer documents. The "current" document is the
         one with the most recent published_at. Old versions stay for audit. Body is HTML;
         only the platform owner can publish so we trust the markup. -->

    <changeSet id="022-create-terms-document" author="claude">
        <createTable tableName="terms_document">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="VARCHAR(32)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="body" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="effective_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="published_by_user_id" type="BIGINT"/>
        </createTable>
        <createIndex tableName="terms_document" indexName="idx_terms_published_at">
            <column name="published_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
