<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="026-bill-payment-table" author="claude">
        <sql>
            CREATE TABLE bill_payment (
                id BIGSERIAL PRIMARY KEY,
                clinic_id BIGINT NOT NULL,
                bill_id BIGINT NOT NULL REFERENCES supplier_bill(id),
                paid_date DATE NOT NULL,
                amount NUMERIC(12,2) NOT NULL,
                payment_mode VARCHAR(30),
                reference_no VARCHAR(100),
                notes VARCHAR(500),
                created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
            )
        </sql>
    </changeSet>

    <changeSet id="026-bill-payment-index-bill" author="claude">
        <sql>CREATE INDEX ix_bill_payment_bill ON bill_payment(bill_id)</sql>
    </changeSet>

    <changeSet id="026-bill-payment-index-clinic" author="claude">
        <sql>CREATE INDEX ix_bill_payment_clinic ON bill_payment(clinic_id)</sql>
    </changeSet>

</databaseChangeLog>
