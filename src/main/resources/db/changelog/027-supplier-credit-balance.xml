<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Tracks advance / overpayment credit per supplier so excess can be
         auto-applied to the next unpaid bill from that supplier. -->
    <changeSet id="027-supplier-credit-balance" author="clinic-ops">
        <addColumn tableName="supplier">
            <column name="credit_balance" type="NUMERIC(10,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="supplier" columnName="credit_balance"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
